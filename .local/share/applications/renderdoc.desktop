[Desktop Entry]
Version=1.0
Name=RenderDoc (XWayland)
Comment=A stand-alone graphics API debugger
GenericName=Graphics Debugger
Exec=env QT_QPA_PLATFORM=xcb qrenderdoc %f
Icon=application-x-renderdoc-capture
Terminal=false
Type=Application
X-MultipleArgs=false
Categories=Development;
Keywords=RenderDoc;
StartupNotify=true
MimeType=application/x-renderdoc-capture;
