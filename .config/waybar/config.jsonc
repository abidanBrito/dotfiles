// config.jsonc

{
    "layer": "top",
    "position": "top",
    "margin-top": 4,
    "margin-left": 4,
    "margin-right": 4,
    "modules-left": ["custom/weather", "hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["tray", "clock", "custom/battery", "pulseaudio", "network"],

    "custom/weather": {
	"exec": "~/.scripts/utils/weather.sh Puerto+del+Rosario+Spain",
	"return-type": "json",
	"format": "{}",
	"tooltip": true,
	"interval": 1800
    },

    "hyprland/workspaces": {
	"on-click": "activate"
    },

    "hyprland/window": {
	"format": "{title}",
	"icon": true,
	"icon-size": 20,
	"max-length": 50
    },

    "hyprland/submap": {
	"format": "{}",
	"tooltip": false
    },

    "tray": {
	"icon-size": 20,
	"spacing": 10
    },

    "clock": {
	"format": "󰥔 {:%H:%M}",
	"format-alt": "󰥔 {:%d %b - %H:%M}",
	"tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
	"calendar": {
	    "mode": "month",
	    "format": {
		"months": "",
		"weekdays": "<b>{}</b>",
		"days": "<b>{}</b>",
		"today": "<span color='#eed49f'><b>{}</b></span>"
	    }
	}
    },

    "custom/battery": {
	"exec": "~/.scripts/utils/battery.sh",
	"return-type": "json",
	"format": "{text}",
	"format-alt": "{alt}",
	"interval": 30,
	"signal": 8,
	"menu": "on-click-right",
	"menu-file": "~/.config/waybar/power_menu.xml",
	"menu-actions": {
	    "performance": "sudo -n tlp performance && pkill -RTMIN+8 waybar && notify-send 'Power profile' 'Performance'",
	    "balanced": "sudo -n tlp balanced && pkill -RTMIN+8 waybar && notify-send 'Power profile' 'Balanced'",
	    "power-saver": "sudo -n tlp power-saver && pkill -RTMIN+8 waybar && notify-send 'Power profile' 'Power Saver'"
	}
    },

    "network": {
	"format-alt": "{icon} {ipaddr}/{cidr}",
	"format-wifi": "{icon} {essid}",
	"format-ethernet": "{icon} Online",
	"format-disconnected": "{icon} Offline",
	"format-icons": {
	    "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
	    "ethernet": "󰈀",
	    "disconnected": "󰤭"
	},
	"tooltip-format": "{ifname}",
	"max-length": 50
    },

    "pulseaudio": {
	"format": " {volume}%",
	"format-alt": "{icon}",
	"format-muted": " {volume}%",
	"format-bluetooth": "󰂱 {volume}%",
	"format-icons": {
	    "speaker": "󰓃 Speakers",
	    "headphone": "󰋋 Headphones",
	    "headset": "󰋎 Headset",
	    "hdmi": "󰡁 HDMI",
	    "default": " Output"
	},
	"ignored-sinks": ["Easy Effects Sink"],
	"scroll-step": 1
    },
}
